# PostgreSQL 数据库名称。
POSTGRES_DB=vmlease

# PostgreSQL 连接用户。
POSTGRES_USER=vmlease

# PostgreSQL 密码，正式环境必须替换。
POSTGRES_PASSWORD=change-me

# Web 对外监听地址和端口；仅本机反向代理时可将地址改为 127.0.0.1。
VMP_HTTP_BIND=0.0.0.0
VMP_HTTP_PORT=8080

# 官方发布镜像；升级时请改为目标版本，不建议在生产环境长期使用 latest。
VMP_BACKEND_IMAGE=lixiaokun/vmp-backend:0.4.1
VMP_FRONTEND_IMAGE=lixiaokun/vmp-frontend:0.4.0

# 使用已有 PostgreSQL 时填写完整连接地址，并使用 compose.external-db.yaml 启动。
# DATABASE_URL=postgres://vmlease:change-me@db.example.com:5432/vmlease?sslmode=require

# Agent 首次注册使用的引导令牌，正式环境必须替换。
AGENT_BOOTSTRAP_TOKEN=change-bootstrap-token

# Agent 心跳和任务通信令牌，正式环境必须替换。
AGENT_RUNTIME_TOKEN=change-agent-token

# 控制面 HTTP 监听地址。
LISTEN_ADDR=:8080

# 首次启动时创建的本地管理员；账号已存在时不会覆盖密码。
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!

# 登录会话时长与 Cookie 安全开关；生产 HTTPS 环境必须设为 true。
SESSION_TTL_HOURS=12
SESSION_COOKIE_SECURE=false

# 用于加密页面中保存的 LDAP 绑定密码，正式环境使用至少 32 位随机值并妥善备份。
SETTINGS_ENCRYPTION_KEY=change-this-settings-encryption-key

# 签发 VNC/串口控制台短时票据的密钥，必须与每台 Agent 保持一致。
CONSOLE_SIGNING_KEY=change-this-console-signing-key-at-least-32-characters

# LDAP 未配置时保持 LDAP_URL 和 LDAP_BASE_DN 为空。
LDAP_URL=
LDAP_START_TLS=false
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=
LDAP_LOGIN_FILTER=(uid=%s)
LDAP_SYNC_FILTER=(objectClass=person)
LDAP_USERNAME_ATTRIBUTE=uid
LDAP_DISPLAY_NAME_ATTRIBUTE=cn
LDAP_EMAIL_ATTRIBUTE=mail
