# PostgreSQL 数据库名称。
POSTGRES_DB=vmlease

# PostgreSQL 连接用户。
POSTGRES_USER=vmlease

# PostgreSQL 密码，正式环境必须替换。
POSTGRES_PASSWORD=change-me

# Agent 首次注册使用的引导令牌，正式环境必须替换。
AGENT_BOOTSTRAP_TOKEN=change-bootstrap-token

# Agent 心跳和任务通信令牌，正式环境必须替换。
AGENT_RUNTIME_TOKEN=change-agent-token

# 控制面 HTTP 监听地址。
LISTEN_ADDR=:8080
